# Copie ce fichier en .env (a la racine du projet, ou dans api/) et remplis-le.
# .env n'est jamais versionne. Sans .env, l'API tourne en local sur SQLite (api/data/).

# Infomaniak : base MySQL/MariaDB creee dans le manager.
DB_DSN=mysql:host=xxxxx.myd.infomaniak.com;dbname=xxxxx_mnemo;charset=utf8mb4
DB_USER=xxxxx_mnemo
DB_PASSWORD=change-moi

# Adresse publique du site, sans barre finale (protection contre les requetes venues d'ailleurs).
APP_ORIGIN=https://mon-site.ch

# E-mails (mot de passe oublie). L'expediteur doit etre une adresse du domaine heberge.
# Sans MAIL_FROM en local, le lien est ecrit dans api/data/mail.log au lieu d'etre envoye.
MAIL_FROM=no-reply@mon-site.ch
# Si le site n'est pas a la racine du domaine : adresse complete, sans barre finale.
# APP_URL=https://mon-site.ch/mnemo

# IA (generation de quiz, completion de cartes) : cle d'API Anthropic. Sans cle, ces boutons sont caches.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# AI_DAILY_LIMIT=40
