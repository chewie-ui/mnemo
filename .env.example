# Copie ce fichier en .env (a la racine du projet, ou dans api/) et remplis-le.
# .env n'est jamais versionne. Sans .env, l'API tourne en local sur SQLite (api/data/).

# Infomaniak : base MySQL/MariaDB creee dans le manager.
DB_DSN=mysql:host=xxxxx.myd.infomaniak.com;dbname=xxxxx_mnemo;charset=utf8mb4
DB_USER=xxxxx_mnemo
DB_PASSWORD=change-moi

# Adresse publique du site, sans barre finale (protection contre les requetes venues d'ailleurs).
APP_ORIGIN=https://mon-site.ch

# E-mails (mot de passe oublie). L'expediteur doit etre une adresse du domaine heberge.
# Sans MAIL_FROM en local, le lien est ecrit dans api/data/mail.log au lieu d'etre envoye.
MAIL_FROM=no-reply@mon-site.ch
# Si le site n'est pas a la racine du domaine : adresse complete, sans barre finale.
# APP_URL=https://mon-site.ch/mnemo

# IA (generation de quiz, completion de cartes). Sans cle, ces boutons sont caches.
# Fournisseur : gemini (gratuit, https://aistudio.google.com), anthropic, mistral, groq, openai.
# Plusieurs fournisseurs : quand l'un est a sec (quota du jour) ou sature, le suivant prend le relais.
# AI_PROVIDERS=gemini,groq,mistral
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# (ou ANTHROPIC_API_KEY=sk-ant-... / MISTRAL_API_KEY=... / GROQ_API_KEY=... / OPENAI_API_KEY=...)
# AI_MODEL=gemini-3.6-flash   (defaut : gemini-3.6-flash, claude-opus-5, mistral-large-latest ; obligatoire pour groq/openai)
# AI_BASE_URL=                (services compatibles OpenAI : adresse de l'API, ex. https://openrouter.ai/api/v1)
# AI_FALLBACK_MODEL=gemini-3.8-flash (modele de secours si le premier est sature)
# AI_DAILY_LIMIT=20           (generations par compte et par jour ; le gratuit Google donne 20/jour/modele)
